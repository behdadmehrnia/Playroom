# LLM Provider (required)
OPENAI_API_KEY=sk-your-key-here
YARKIDS_BACKEND_MODEL=gpt-4o-mini
YARKIDS_LLM_BASE_URL=https://api.openai.com/v1

# Optional: Custom LLM endpoints (Ollama, vLLM, etc.)
# YARKIDS_LLM_BASE_URL=http://host.docker.internal:11434/v1
# YARKIDS_BACKEND_MODEL=llama3.1

# Textbook Service (internal Docker network)
YARKIDS_TEXTBOOK_API_URL=http://textbook-service:8080
YARKIDS_ENABLE_TEXTBOOK_CONTEXT=true
YARKIDS_TEXTBOOK_REQUEST_TIMEOUT_SEC=5.0
YARKIDS_TEXTBOOK_NEIGHBOR_PAGES=1
YARKIDS_TEXTBOOK_INCLUDE_IMAGE=auto
YARKIDS_TEXTBOOK_DEBUG=false

# Web Search
YARKIDS_ENABLE_WEB_SEARCH=true
YARKIDS_WEB_SEARCH_PROVIDER=auto
YARKIDS_WEB_SEARCH_API_URL=
YARKIDS_WEB_SEARCH_API_KEY=
YARKIDS_WEB_SEARCH_MAX_RESULTS=5
YARKIDS_WEB_SEARCH_REQUEST_TIMEOUT_SEC=8.0
YARKIDS_WEB_SEARCH_DEBUG=false

# Reflection
YARKIDS_ENABLE_REFLECTION=true

# Server
YARKIDS_API_HOST=0.0.0.0
YARKIDS_API_PORT=8000
YARKIDS_CORS_ORIGINS=*
YARKIDS_ENABLE_STATUS_UPDATES=true
YARKIDS_TEMPERATURE=0.7