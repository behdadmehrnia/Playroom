# Agentic Workflow Configuration
YARKIDS_BACKEND_MODEL=gpt-5
YARKIDS_LLM_BASE_URL=https://api.openai.com/v1
YARKIDS_LLM_API_KEY=
YARKIDS_LLM_TIMEOUT_SEC=120
YARKIDS_TEMPERATURE=0.7
YARKIDS_ENABLE_REFLECTION=true
YARKIDS_ENABLE_STATUS_UPDATES=true
YARKIDS_ENABLE_CHAT_TITLE=true
YARKIDS_CHAT_TITLE_MIN_USER_MESSAGES=2
YARKIDS_ENABLE_TEXTBOOK_CONTEXT=true
YARKIDS_ENABLE_WEB_SEARCH=true

# Textbook Service Configuration
YARKIDS_TEXTBOOK_API_URL=
YARKIDS_TEXTBOOK_API_KEY=
YARKIDS_TEXTBOOK_REQUEST_TIMEOUT_SEC=120
YARKIDS_TEXTBOOK_NEIGHBOR_PAGES=1
YARKIDS_TEXTBOOK_INCLUDE_IMAGE=auto
YARKIDS_TEXTBOOK_DEBUG=false

# Web Search Configuration
# provider: auto | api | perplexity | duckduckgo | gerdoo
# Or a comma-separated fallback chain (tried in order until one matches)
# auto default order: api → perplexity → duckduckgo → gerdoo
YARKIDS_WEB_SEARCH_PROVIDER=api,perplexity,duckduckgo,gerdoo
YARKIDS_WEB_SEARCH_API_URL=
YARKIDS_WEB_SEARCH_API_KEY=
# Gerdoo (gerdoo.me) — GET .../search?query=...
# Example: http://185.149.192.142:8888
YARKIDS_WEB_SEARCH_GERDOO_URL=
# Base or full URL for Perplexity-style search (GET .../api/v1/search?query=...)
YARKIDS_WEB_SEARCH_PERPLEXITY_URL=
YARKIDS_WEB_SEARCH_REQUEST_TIMEOUT_SEC=8
YARKIDS_WEB_SEARCH_MAX_RESULTS=5
YARKIDS_WEB_SEARCH_DEBUG=false

# API Configuration
YARKIDS_API_HOST=0.0.0.0
YARKIDS_API_PORT=8000
