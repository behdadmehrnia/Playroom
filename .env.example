# Agentic Workflow Configuration
PLAYROOM_BACKEND_MODEL=gpt-5
PLAYROOM_LLM_BASE_URL=https://api.openai.com/v1
PLAYROOM_LLM_API_KEY=
PLAYROOM_LLM_TIMEOUT_SEC=120
PLAYROOM_TEMPERATURE=0.7
PLAYROOM_ENABLE_REFLECTION=true
PLAYROOM_ENABLE_STATUS_UPDATES=true
PLAYROOM_ENABLE_CHAT_TITLE=true
PLAYROOM_CHAT_TITLE_MIN_USER_MESSAGES=2
PLAYROOM_ENABLE_TEXTBOOK_CONTEXT=true
PLAYROOM_ENABLE_WEB_SEARCH=true

# Textbook Service Configuration
PLAYROOM_TEXTBOOK_API_URL=
PLAYROOM_TEXTBOOK_API_KEY=
PLAYROOM_TEXTBOOK_REQUEST_TIMEOUT_SEC=120
PLAYROOM_TEXTBOOK_NEIGHBOR_PAGES=1
PLAYROOM_TEXTBOOK_INCLUDE_IMAGE=auto
PLAYROOM_TEXTBOOK_DEBUG=false

# Web Search Configuration
# provider: auto | api | perplexity | duckduckgo | gerdoo
# Or a comma-separated fallback chain (tried in order until one matches)
# auto default order: api → perplexity → duckduckgo → gerdoo
PLAYROOM_WEB_SEARCH_PROVIDER=api,perplexity,duckduckgo,gerdoo
PLAYROOM_WEB_SEARCH_API_URL=
PLAYROOM_WEB_SEARCH_API_KEY=
# Gerdoo (gerdoo.me) — GET .../search?query=...
# Example: http://185.149.192.142:8888
PLAYROOM_WEB_SEARCH_GERDOO_URL=
# Base or full URL for Perplexity-style search (GET .../api/v1/search?query=...)
PLAYROOM_WEB_SEARCH_PERPLEXITY_URL=
PLAYROOM_WEB_SEARCH_REQUEST_TIMEOUT_SEC=8
PLAYROOM_WEB_SEARCH_MAX_RESULTS=5
PLAYROOM_WEB_SEARCH_DEBUG=false

# API Configuration
PLAYROOM_API_HOST=0.0.0.0
PLAYROOM_API_PORT=8000
